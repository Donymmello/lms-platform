# Banco de Dados
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_db

# Backend
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# JWT (usa segredos fortes e distintos para access/refresh em produção)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Provedores Externos
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_api_key

MPESA_API_KEY=your_mpesa_key
MPESA_PUBLIC_KEY=your_mpesa_public_key

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
