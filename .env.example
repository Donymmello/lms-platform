# Copia para `.env` na raiz. Tudo aqui tem um valor por omissão no
# docker-compose.yml, por isso só precisas de definir o que queres mudar —
# excepto os segredos, que tens de definir antes de expor isto a alguém.

# --- Base de dados ---
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_db
# Porta no host, só para psql/Adminer de fora do Docker. O backend fala com
# o Postgres por `lms-postgres:5432` na rede do compose.
POSTGRES_HOST_PORT=5434

# --- Portas no host (desenvolvimento) ---
# 5000 é um número disputado: se outro projecto na máquina já a tiver, a stack
# falha a arrancar com um lacónico "port is already allocated". Muda aqui, e
# muda o NEXT_PUBLIC_API_URL abaixo para a mesma porta — em desenvolvimento o
# browser fala directamente com ela.
BACKEND_HOST_PORT=5000

# --- Endereços: desenvolvimento ---
# Vai compilado no bundle do browser, logo tem de ser um endereço que o
# browser do VISITANTE alcance.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000
# Usados para construir URLs absolutos em emails e nos retornos/webhooks dos
# gateways. PUBLIC_API_URL tem de ser alcançável da internet para os webhooks
# chegarem.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# --- Endereços: produção (docker-compose.prod.yml) ---
# A stack de produção ignora as quatro variáveis acima e deriva tudo destas
# duas. Ver "Pôr numa VPS" no README.
#   PUBLIC_ORIGIN=https://demo.teudominio.com
#   SITE_ADDRESS=demo.teudominio.com
# Deixa vazio para um cookie ligado ao host, que é o correcto com um único
# hostname. Só precisa de valor se servires a app e a API em subdomínios.
COOKIE_DOMAIN=

# --- Segredos: TROCA ANTES DE PARTILHAR ---
# Os valores por omissão no docker-compose.yml estão escritos neste
# repositório. Quem o lê consegue forjar um token de sessão de qualquer
# utilizador, ou abrir os segredos 2FA guardados.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32 bytes em hexadecimal (64 caracteres). Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# --- Contacto ---
# Para onde escreve quem quer ensinar. A subida a instrutor é feita à mão por
# um admin em /admin/users, por isso a página /ensinar aponta para aqui.
# Vazio é válido: a página explica o papel e não mostra endereço nenhum.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Email ---
# Por omissão aponta para o Mailpit, o apanhador de emails de
# desenvolvimento, em http://localhost:8025. Para entregar a sério, aponta
# para um servidor SMTP real.
SMTP_HOST=lms-mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Cuidado: "true" só em porta TLS. Numa porta de texto simples como a 1025,
# forçar TLS faz o envio falhar.
SMTP_SECURE=false
MAIL_FROM=LMS <nao-responder@localhost>
MAILPIT_UI_PORT=8025

# --- Vídeo ---
# Sem estas três, os vídeos das aulas ficam no disco do servidor e são
# servidos por ele (ver "Vídeos das aulas" no README). São precisas as três:
# faltando uma, o Bunny conta como não configurado.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_BASE_URL=https://video.bunnycdn.com
BUNNY_STREAM_TOKEN_TTL_SECONDS=3600

# --- Pagamentos ---
# PaySuite: M-Pesa e e-Mola em Moçambique.
PAYSUITE_BASE_URL=https://paysuite.tech/api/v1
PAYSUITE_API_KEY=
PAYSUITE_WEBHOOK_SECRET=

# PayPal. O valor por omissão da base é a sandbox; troca para
# https://api-m.paypal.com em produção.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# O PayPal não aceita MZN, por isso os preços são convertidos a esta taxa.
PAYPAL_MZN_PER_USD_RATE=64

# --- Rede partilhada (só se outro servidor web já corre na VPS) ---
# Nome da rede Docker do Caddy/nginx que já lá está. Usado apenas pelo
# docker-compose.shared-proxy.yml, para o proxy desta stack ser alcançável por
# nome a partir dele. Descobre-o com:
#   docker inspect <container-do-caddy> -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}'
SHARED_PROXY_NETWORK=
