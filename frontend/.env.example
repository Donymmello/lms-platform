NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Only needed when frontend and backend run in separate Docker containers.
# Server-side code (Server Components, generateMetadata) can't reach the
# backend via `localhost` from inside the frontend container — it needs the
# backend's Docker-network hostname instead. Leave unset outside Docker.
INTERNAL_API_URL=http://backend:5000/api/v1
