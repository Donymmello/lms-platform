// LMS Platform — Prisma schema
// Auth + Users modules are defined here. Other modules (courses, payments,
// progress, analytics) will extend this file as they are implemented.

generator client {
  provider = "prisma-client-js"
  // `node:20-alpine` ships OpenSSL 3.x, not the 1.1.x Prisma defaults to
  // when it can't detect the version on a minimal image. Pinning the musl
  // + OpenSSL 3.0 engine here (alongside "native" for local, non-Alpine
  // dev) avoids the "Error loading shared library libssl.so.1.1" crash.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String // bcrypt hash — never the plaintext password
  role      Role     @default(STUDENT)
  /// Deactivated accounts are blocked at login/refresh (see auth.service.ts)
  /// rather than deleted, preserving their history (enrollments, purchases).
  isActive  Boolean  @default(true)

  /// TOTP shared secret, encrypted at rest (see utils/secret-box.ts). Null
  /// until the user starts enrolling a device. Encrypted rather than stored
  /// raw because anyone holding it can mint valid codes forever, and the key
  /// lives in the environment rather than in the database.
  twoFactorSecret    String?
  /// Set only once a code from the device has been verified, so a half-finished
  /// enrolment can never lock anyone out.
  twoFactorEnabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  recoveryCodes       TwoFactorRecoveryCode[]
  coursesTaught   Course[]
  enrollments     Enrollment[]
  payments        Payment[]
  lessonProgress  LessonProgress[]
  assessmentAttempts AssessmentAttempt[]
  auditEvents        AuditEvent[]       @relation("AuditActor")

  @@map("users")
}

/// One row per issued refresh token (hashed, never the raw value), so that
/// individual sessions/devices can be revoked and rotation reuse can be
/// detected without invalidating every session for the user.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(uuid())
  title       String
  /// URL-safe identifier, derived from title at creation time and kept
  /// unique (see courses.service.ts) — used for public course URLs later.
  slug        String       @unique
  description String       @default("")
  /// An image hosted somewhere else, pasted as a URL by the instructor.
  thumbnailUrl String?
  /// A cover uploaded to this server. The file name only; the URL is built by
  /// whoever renders it, so moving the platform to another domain does not
  /// leave every course pointing at the old one.
  coverKey     String?
  priceCents  Int          @default(0)
  status      CourseStatus @default(DRAFT)

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  modules      CourseModule[]
  enrollments  Enrollment[]
  /// Through the items, because a payment can cover several courses at once.
  paymentItems PaymentItem[]
  liveSessions LiveSession[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([instructorId])
  @@map("courses")
}

/// A named, ordered section within a course (e.g. "Módulo 1: Introdução")
/// that groups lessons. Deliberately named CourseModule (not "Module") to
/// avoid clashing with the Node.js/backend-architecture sense of "module".
model CourseModule {
  id       String @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons    Lesson[]
  assessment Assessment?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId])
  @@map("course_modules")
}

/// The quiz at the end of a module. One per module — the module is the unit a
/// student finishes, so that is where the check belongs.
model Assessment {
  id       String       @id @default(uuid())
  moduleId String       @unique
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title String
  /// Percentage needed to pass, 0-100. Informational: nothing is locked behind
  /// it, a student who fails can retake and can move on either way.
  passScore Int @default(70)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessments")
}

/// There is no question "type" column on purpose. A question with one correct
/// option is single-choice, one with several is "select all that apply", and
/// true/false is just a question whose two options are Verdadeiro and Falso.
/// The shape of the options already says which it is.
model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  prompt String
  order  Int

  options AssessmentOption[]
  answers AssessmentAnswer[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id         String             @id @default(uuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text String
  /// Never leaves the server for a student — see the DTOs in the assessments
  /// module, which have separate shapes for taking a quiz and editing one.
  isCorrect Boolean
  order     Int

  @@index([questionId])
  @@map("assessment_options")
}

/// One sitting. Attempts are unlimited and every one is kept: the best score
/// is what counts, and the history is what lets a student see they improved.
model AssessmentAttempt {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0-100, rounded. Whole questions only: selecting two of three correct
  /// options scores nothing for that question rather than two thirds.
  score  Int
  passed Boolean

  answers   AssessmentAnswer[]
  createdAt DateTime @default(now())

  @@index([assessmentId, userId])
  @@map("assessment_attempts")
}

/// What was picked, so a finished attempt can be reviewed question by question.
model AssessmentAnswer {
  id        String            @id @default(uuid())
  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// The option ids the student chose. An array rather than a join table: it is
  /// only ever read back whole, alongside its attempt.
  selectedOptionIds String[]
  correct           Boolean

  @@index([attemptId])
  @@index([questionId])
  @@map("assessment_answers")
}

model Lesson {
  id          String  @id @default(uuid())
  title       String
  description String  @default("")
  order       Int
  /// Free preview lessons are playable without an enrollment/purchase.
  isFreePreview Boolean @default(false)

  /// Populated once the video module wires up Bunny Stream (signed URLs
  /// are generated on demand from this id — never a direct/public video URL).
  bunnyVideoId    String?
  durationSeconds Int?

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  materials LessonMaterial[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

/// A downloadable that goes with a lesson — slides, a worksheet, the source
/// files. Always kept on this server's own disk: Bunny Stream hosts video and
/// nothing else, so there is no CDN path to fall back to here.
model LessonMaterial {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// The name the instructor's file had. Shown to students and used for the
  /// download, but never as a path — see storedName for that.
  fileName    String
  contentType String
  sizeBytes   Int
  /// The single path segment the bytes live under, inside the materials
  /// directory. Generated here, never taken from the upload.
  storedName  String

  createdAt DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_materials")
}

/// One row per (user, lesson) the user has ever opened. `lastAccessedAt` is
/// touched every time a signed playback URL is issued to them (see
/// playback.service.ts) and drives "continue where you left off";
/// `completedAt` is only set by an explicit "mark as complete" action (see
/// progress.service.ts) and drives the course progress bar. Never created
/// for anonymous free-preview viewing — only for a logged-in user.
model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt    DateTime?
  /// How far into the video this student has watched, so re-opening a lesson
  /// picks up where they stopped instead of at zero.
  positionSeconds Int      @default(0)
  lastAccessedAt DateTime  @default(now()) @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// One-shot codes for getting back in when the authenticator device is gone.
/// Stored as hashes for the same reason password reset tokens are: the plain
/// values are shown to the user once, at enrolment, and never again.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

/// A single-use ticket for setting a new password without being signed in.
///
/// Only the SHA-256 hash is stored, exactly like RefreshToken: the raw token
/// exists only in the email that was sent, so a leaked database dump cannot
/// be used to take over accounts. `usedAt` makes it single-use and
/// `expiresAt` keeps the window short — both are checked on redemption, and
/// requesting a new token invalidates any earlier unused one.
/// A record of the acts that change who can do what: role changes, the
/// self-service instructor upgrade, accounts being switched off, two-factor
/// being turned on or off, a password actually being reset.
///
/// Ordinary reads and writes are not here. This is for answering "who did
/// this, and when" about the handful of changes where that question gets
/// asked, and a log of everything would bury those.
model AuditEvent {
  id String @id @default(uuid())

  /// Null when the act had no signed-in actor, or when the account was later
  /// deleted. `actorEmail` is kept alongside precisely so the record still
  /// names someone after that: an audit trail that a deletion can blank is
  /// not an audit trail.
  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  /// Dotted and past tense, e.g. `user.role_changed`.
  action String

  /// What it happened to. Free-form because it is not always a user.
  targetType String?
  targetId   String?
  /// Whatever else is worth keeping and does not deserve a column: the old
  /// and new role, which method disabled two-factor.
  metadata Json?

  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A scheduled live class for a course. The platform does not host the call:
/// the instructor pastes a meeting link (Zoom, Meet, whatever they already
/// use) and this row carries the schedule around it. `joinUrl` is only ever
/// sent to someone entitled to attend — see live-sessions.service.ts.
model LiveSession {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  joinUrl         String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courseId, startsAt])
  @@map("live_sessions")
}

/// A user's enrollment in a course. Free courses (priceCents = 0) create
/// this immediately on self-enrollment; priced courses only get one once
/// the linked Payment reaches COMPLETED (see payments.service.ts). One row
/// per (user, course) pair — enrolling twice is rejected as a conflict
/// rather than creating duplicate rows.
model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The payment that unlocked this enrollment, if any (null for free courses).
  /// Not unique: one cart payment unlocks every course that was in it.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([paymentId])
  @@map("enrollments")
}

enum PaymentProvider {
  MPESA
  EMOLA
  /// Visa and Mastercard, through PaySuite's hosted page. PaySuite calls this
  /// method `credit_card`; there is no separate value per card network.
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per checkout attempt. `reference` is OUR idempotency key —
/// generated before calling out to the gateway and never reused — so a
/// retried checkout or a duplicated webhook delivery can never double-charge
/// or double-enroll (see payments.service.ts). `providerTxnId` is the
/// gateway's own id (PaySuite payment ULID / PayPal order id), used to
/// correlate webhook callbacks back to this row. `rawPayload` keeps the last
/// webhook body for audits — it is never trusted over the verified fields.
/// One trip to a gateway, covering one or more courses.
///
/// A cart is why this is not one payment per course: every M-Pesa charge is a
/// USSD confirmation on the buyer's phone, so three courses bought together
/// have to be one charge, not three.
model Payment {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  /// The total actually sent to the gateway — the sum of the items below, kept
  /// as its own column because it is what the gateway was told and must not
  /// change if a course is repriced afterwards.
  amountCents   Int
  currency      String          @default("MZN")
  reference     String          @unique
  providerTxnId String?
  rawPayload    Json?
  items         PaymentItem[]
  enrollments   Enrollment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([providerTxnId])
  @@map("payments")
}

/// One course inside a payment, at the price it had when the buyer paid.
model PaymentItem {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// Copied from the course rather than read back from it later: a course that
  /// goes on sale next week must not rewrite what someone paid.
  amountCents Int

  /// The same course cannot be in one payment twice.
  @@unique([paymentId, courseId])
  @@index([courseId])
  @@map("payment_items")
}
