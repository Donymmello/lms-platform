// LMS Platform — Prisma schema
// Auth + Users modules are defined here. Other modules (courses, payments,
// progress, analytics) will extend this file as they are implemented.

generator client {
  provider = "prisma-client-js"
  // `node:20-alpine` ships OpenSSL 3.x, not the 1.1.x Prisma defaults to
  // when it can't detect the version on a minimal image. Pinning the musl
  // + OpenSSL 3.0 engine here (alongside "native" for local, non-Alpine
  // dev) avoids the "Error loading shared library libssl.so.1.1" crash.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String // bcrypt hash — never the plaintext password
  role      Role     @default(STUDENT)
  /// Deactivated accounts are blocked at login/refresh (see auth.service.ts)
  /// rather than deleted, preserving their history (enrollments, purchases).
  isActive  Boolean  @default(true)

  /// TOTP shared secret, encrypted at rest (see utils/secret-box.ts). Null
  /// until the user starts enrolling a device. Encrypted rather than stored
  /// raw because anyone holding it can mint valid codes forever, and the key
  /// lives in the environment rather than in the database.
  twoFactorSecret    String?
  /// Set only once a code from the device has been verified, so a half-finished
  /// enrolment can never lock anyone out.
  twoFactorEnabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  recoveryCodes       TwoFactorRecoveryCode[]
  coursesTaught   Course[]
  enrollments     Enrollment[]
  payments        Payment[]
  lessonProgress  LessonProgress[]

  @@map("users")
}

/// One row per issued refresh token (hashed, never the raw value), so that
/// individual sessions/devices can be revoked and rotation reuse can be
/// detected without invalidating every session for the user.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(uuid())
  title       String
  /// URL-safe identifier, derived from title at creation time and kept
  /// unique (see courses.service.ts) — used for public course URLs later.
  slug        String       @unique
  description String       @default("")
  thumbnailUrl String?
  priceCents  Int          @default(0)
  status      CourseStatus @default(DRAFT)

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  modules      CourseModule[]
  enrollments  Enrollment[]
  payments     Payment[]
  liveSessions LiveSession[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([instructorId])
  @@map("courses")
}

/// A named, ordered section within a course (e.g. "Módulo 1: Introdução")
/// that groups lessons. Deliberately named CourseModule (not "Module") to
/// avoid clashing with the Node.js/backend-architecture sense of "module".
model CourseModule {
  id       String @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id          String  @id @default(uuid())
  title       String
  description String  @default("")
  order       Int
  /// Free preview lessons are playable without an enrollment/purchase.
  isFreePreview Boolean @default(false)

  /// Populated once the video module wires up Bunny Stream (signed URLs
  /// are generated on demand from this id — never a direct/public video URL).
  bunnyVideoId    String?
  durationSeconds Int?

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress  LessonProgress[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("lessons")
}


/// One row per (user, lesson) the user has ever opened. `lastAccessedAt` is
/// touched every time a signed playback URL is issued to them (see
/// playback.service.ts) and drives "continue where you left off";
/// `completedAt` is only set by an explicit "mark as complete" action (see
/// progress.service.ts) and drives the course progress bar. Never created
/// for anonymous free-preview viewing — only for a logged-in user.
model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt    DateTime?
  /// How far into the video this student has watched, so re-opening a lesson
  /// picks up where they stopped instead of at zero.
  positionSeconds Int      @default(0)
  lastAccessedAt DateTime  @default(now()) @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// One-shot codes for getting back in when the authenticator device is gone.
/// Stored as hashes for the same reason password reset tokens are: the plain
/// values are shown to the user once, at enrolment, and never again.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

/// A single-use ticket for setting a new password without being signed in.
///
/// Only the SHA-256 hash is stored, exactly like RefreshToken: the raw token
/// exists only in the email that was sent, so a leaked database dump cannot
/// be used to take over accounts. `usedAt` makes it single-use and
/// `expiresAt` keeps the window short — both are checked on redemption, and
/// requesting a new token invalidates any earlier unused one.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A scheduled live class for a course. The platform does not host the call:
/// the instructor pastes a meeting link (Zoom, Meet, whatever they already
/// use) and this row carries the schedule around it. `joinUrl` is only ever
/// sent to someone entitled to attend — see live-sessions.service.ts.
model LiveSession {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String   @default("")
  joinUrl         String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courseId, startsAt])
  @@map("live_sessions")
}

/// A user's enrollment in a course. Free courses (priceCents = 0) create
/// this immediately on self-enrollment; priced courses only get one once
/// the linked Payment reaches COMPLETED (see payments.service.ts). One row
/// per (user, course) pair — enrolling twice is rejected as a conflict
/// rather than creating duplicate rows.
model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The payment that unlocked this enrollment, if any (null for free courses).
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

enum PaymentProvider {
  MPESA
  EMOLA
  PAYPAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per checkout attempt. `reference` is OUR idempotency key —
/// generated before calling out to the gateway and never reused — so a
/// retried checkout or a duplicated webhook delivery can never double-charge
/// or double-enroll (see payments.service.ts). `providerTxnId` is the
/// gateway's own id (PaySuite payment ULID / PayPal order id), used to
/// correlate webhook callbacks back to this row. `rawPayload` keeps the last
/// webhook body for audits — it is never trusted over the verified fields.
model Payment {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amountCents   Int
  currency      String          @default("MZN")
  reference     String          @unique
  providerTxnId String?
  rawPayload    Json?
  enrollment    Enrollment?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([providerTxnId])
  @@map("payments")
}
