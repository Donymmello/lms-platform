# Ambiente
NODE_ENV=development
PORT=5000

# Base de dados (usada diretamente pelo Prisma; em Docker é injetada pelo docker-compose.yml)
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db?schema=public

# JWT — gera segredos distintos e fortes (>=32 caracteres) para cada ambiente
JWT_ACCESS_SECRET=change_me_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / Cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# URLs públicas — usadas para construir os return_url/webhook_url enviados
# aos gateways de pagamento (eles não conseguem resolver caminhos relativos)
PUBLIC_API_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:3000

# Pagamentos — PaySuite (agregador M-Pesa + e-Mola para Moçambique)
# Cria conta em https://paysuite.tech/dashboard/register para obter a API key
# e configurar o segredo do webhook.
PAYSUITE_BASE_URL=https://paysuite.tech/api/v1
PAYSUITE_API_KEY=
PAYSUITE_WEBHOOK_SECRET=

# Pagamentos — PayPal (Orders v2 REST API; sandbox por omissão)
# Cria uma app em https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# O PayPal não suporta MZN como moeda de transação — o preço em MZN é
# convertido para esta moeda usando a taxa estática abaixo (substitui por
# uma fonte de câmbio real antes de ires para produção).
PAYPAL_CURRENCY=USD
PAYPAL_MZN_PER_USD_RATE=64
