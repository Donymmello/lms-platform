{
	# Preserve the client IP that an upstream proxy already recorded.
	#
	# Caddy does not trust an incoming X-Forwarded-For by default, and it is
	# right not to: anyone could forge it. But on a VPS this sits behind the
	# web server already on the box, so the header arriving from a private
	# address is that server reporting the real visitor. Discarding it makes
	# every request look like it came from the proxy, and the backend's
	# per-IP rate limits then share one counter across the whole internet —
	# ten failed logins from anybody would lock out everyone.
	#
	# Only private ranges are trusted, which on this host is the proxy
	# container and nothing reachable from outside.
	servers {
		trusted_proxies static private_ranges
	}
}

# One origin in front of both services: the app at the root, the API under
# /api. The browser only ever sees one scheme, host and port, which is what
# keeps the SameSite=Lax session cookies working.
#
# SITE_ADDRESS decides whether this terminates TLS:
#
#   SITE_ADDRESS=demo.teudominio.com   -> automatic HTTPS from Let's Encrypt
#   SITE_ADDRESS=:8090                 -> plain HTTP on 8090, no certificate
#
# The first is for a VPS with a domain pointed at it, and is the only mode
# where signing in works: in production the session cookies are marked Secure,
# so they are never sent over plain HTTP. The second exists for a tunnel,
# which terminates TLS itself, and for looking at the production build locally.
#
# Nothing here caps the request body. Caddy streams uploads through by
# default, so a 500MB lesson video arrives whole — unlike Cloudflare's proxy,
# which cuts requests at 100MB on its free plans.

{$SITE_ADDRESS} {
	handle /api/* {
		reverse_proxy lms-backend:5000
	}

	handle {
		reverse_proxy lms-frontend:3000
	}
}
